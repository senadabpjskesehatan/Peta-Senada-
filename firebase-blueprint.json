{
  "entities": {
    "app_settings": {
      "title": "App Settings",
      "description": "Global application settings and map indicators",
      "properties": {
        "navOrder": { "type": "array", "items": { "type": "string" }, "description": "Navigation items order" },
        "syncInterval": { "type": "string", "description": "Auto sync interval" },
        "lastSyncedAt": { "type": "string", "description": "Last synchronization timestamp" },
        "volumeThresholds": {
          "type": "object",
          "description": "Volume indicator thresholds for map"
        },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": []
    },
    "map_data": {
      "title": "Map Data & Config",
      "description": "Synced cities and spreadsheet connection configuration",
      "properties": {
        "cities": { "type": "array", "description": "List of Indonesian city data points" },
        "syncConfig": { "type": "object", "description": "Google Sheet synchronization settings" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": []
    },
    "dynamic_charts": {
      "title": "Dynamic Charts",
      "description": "Customizable visualization charts configured by admin",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "metric": { "type": "string" },
        "colorScheme": { "type": "string" },
        "sortOrder": { "type": "string" },
        "dataSource": { "type": "string" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "type"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
